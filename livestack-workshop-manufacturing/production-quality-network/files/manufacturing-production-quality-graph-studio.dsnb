        "message": [
          "%md",
          "",
          "This visualization centers on material lot LOT-ST-91A7. The fixture links production orders PO-8841, PO-5077, and PO-1190 to that lot. Inspect the supplier and material-certificate links as supporting records. A shared lot identifies orders to review; it does not establish that every associated order contains a defective component."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
