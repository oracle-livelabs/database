        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* List centers in descending order of pagerank values*/",
          "SELECT a.center_id, a.pagerank AS pageRank",
          "FROM MATCH (a) ON material_flow_graph",
          "ORDER BY PageRank DESC",
          "LIMIT 10"
        ],
