        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Find the top 3 shortest paths between center 934 and center 387 */",
          "SELECT v,e,v2",
          "FROM MATCH TOP 3 SHORTEST (a)-[:TRANSFERS]->+ (b) ON material_flow_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.center_id=934 AND b.center_id=387"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": "[{\"visualization\": {\"vertexLabelProperty\": \"CENTER_ID\", \"version\": 9}}]",
