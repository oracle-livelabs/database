        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "List PageRank values in descending order. A high rank means that a center has incoming links from centers that themselves carry rank. This is a structural graph measure; it does not prove a quality defect or measure material volume."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
