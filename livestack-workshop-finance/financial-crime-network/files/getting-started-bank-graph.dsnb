        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%pgql-pgx",
          "/* Query and visualize 100 elements (nodes and edges) of BANK_GRAPH */",
          "SELECT *",
          "FROM MATCH (s)-[t]->(d) ON bank_graph",
          "LIMIT 100"
        ],
