          "%pgql-pgx",
          "/* Check if there are any circular payment chains of length 5 from acct 934 */",
          "SELECT v,e,v2",
          "FROM MATCH ALL (a)-[:TRANSFERS]->{5}(b) ON bank_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.acct_id=934 AND id(a) = id(b)",
          "LIMIT 100 "
