          "  SELECT v,e,v2",
          "  FROM MATCH ANY (n)-[:Transfers]->{6}(m) ON bank_graph ONE ROW PER STEP (v,e,v2)",
          "  WHERE n.acct_id = 934 ",
          "  LIMIT 100"
