          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "<p>Next, let's use PGQL to find the top 10 accounts regarding the number of transfers.</p>\n<p>PGQL has built-in functions <strong>IN_DEGREE</strong> and <strong>OUT_DEGREE</strong>, which return the number of incoming and outgoing edges of a node. So we can use them in this query.</p>\n<p>Run the paragraph with the following query.</p>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%pgql-pgx",
          "/* List 10 accounts with the most number of transactions (that is, incoming + outgoing edges) */",
          "SELECT a.acct_id, (in_degree(a) + out_degree(a)) AS num_transactions",
          "FROM MATCH (a) ON bank_graph",
          "ORDER BY num_transactions DESC",
          "LIMIT 10"
        ],
