      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%sql",
          "SELECT DISTINCT entity_key, display_name, entity_type, risk_score, risk_level, affected_capacity, channel\nFROM GRAPH_TABLE (service_disruption_network\n  MATCH (seed IS entity) -[e IS related_to]->{1,2} (reached IS entity)\n  WHERE seed.entity_key = 'TRIP-8841'\n  COLUMNS (\n    reached.entity_key AS entity_key,\n    reached.display_name AS display_name,\n    reached.entity_type AS entity_type,\n    reached.risk_score AS risk_score,\n    reached.risk_level AS risk_level,\n    reached.affected_capacity AS affected_capacity,\n    reached.channel AS channel\n  )\n)\nORDER BY risk_score DESC\nFETCH FIRST 25 ROWS ONLY;"
        ],
        "selectedVisualization": "table",
        "visualizationConfig": null,
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}"
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "",
          "This graph view draws the trip and its connections within two relationship hops. Select an edge to inspect the relationship."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}"
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%sql",
          "SELECT *\nFROM GRAPH_TABLE (\n  service_disruption_network\n  MATCH (src IS entity)-[e IS related_to]->{1,2}(dst IS entity)\n  WHERE src.entity_key = 'TRIP-8841'\n  ONE ROW PER STEP (v1, e1, v2)\n  COLUMNS (\n    vertex_id(src) AS seed_id,\n    vertex_id(v1) AS v1_id,\n    edge_id(e1) AS e1_id,\n    vertex_id(v2) AS v2_id\n  )\n);"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": null,
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}"
      },
      {
        "row": 0,
