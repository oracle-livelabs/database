        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "",
          "The final query finds trip pairs connected through one shared station or vehicle. Compare the keys with Task 4 in the lab."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}"
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%sql",
          "SELECT trip_a, shared_entity, shared_type, trip_b\nFROM GRAPH_TABLE (service_disruption_network\n  MATCH (a IS entity)-[e1 IS related_to]->(shared IS entity)<-[e2 IS related_to]-(b IS entity)\n  WHERE a.entity_type = 'trip' AND b.entity_type = 'trip'\n    AND a.entity_id < b.entity_id\n    AND shared.entity_type IN ('station','vehicle')\n  COLUMNS (a.entity_key AS trip_a, shared.entity_key AS shared_entity,\n           shared.entity_type AS shared_type, b.entity_key AS trip_b)\n)\nFETCH FIRST 25 ROWS ONLY;"
        ],
        "selectedVisualization": "table",
        "visualizationConfig": null,
