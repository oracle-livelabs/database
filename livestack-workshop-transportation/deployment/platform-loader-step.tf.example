# Install create_user.sql.tmpl in the platform's existing user-setup step.
# That step creates LLUSER, grants privileges, and loads LLUSER.ALL_MINILM_L12_V2.
# Run this data step only after user setup and the GENAI profile step (atp3).
resource "null_resource" "sqlcl-load-data-atp4" {
  provisioner "local-exec" {
    working_dir = path.module
    command     = "sql -cloudconfig atp_wallet.zip lluser/${local.new_password}@ATP${var.resId}_high @./load_seer_transport.sql"
  }

  depends_on = [null_resource.sqlcl-load-data-atp3]
}
