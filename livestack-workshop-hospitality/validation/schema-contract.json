{
  "status": "Phase 1 design contract; not deployed DDL or a tested loader",
  "schema": "LLUSER",
  "currency": "USD",
  "objects": {
    "HOTEL_PROPERTIES": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "PROPERTY_ID": "NUMBER PK",
        "PROPERTY_NAME": "VARCHAR2(120)",
        "CITY": "VARCHAR2(100)",
        "STATE_PROVINCE": "VARCHAR2(100)",
        "LATITUDE": "NUMBER",
        "LONGITUDE": "NUMBER",
        "LOCATION": "SDO_GEOMETRY",
        "ROOM_CAPACITY": "NUMBER",
        "OCCUPIED_ROOMS_PCT": "NUMBER",
        "IS_ACTIVE": "NUMBER(1)"
      },
      "note": ""
    },
    "STAY_OFFERS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "OFFER_ID": "NUMBER PK",
        "PROPERTY_ID": "NUMBER FK",
        "OFFER_NAME": "VARCHAR2(160)",
        "ROOM_TYPE": "VARCHAR2(80)",
        "RATE_PLAN": "VARCHAR2(80)",
        "CATEGORY": "VARCHAR2(100)",
        "SUBCATEGORY": "VARCHAR2(100)",
        "NIGHTLY_RATE": "NUMBER(12,2)",
        "IS_ACTIVE": "NUMBER(1)"
      },
      "note": "One offer is a room type plus rate plan at one property; prices and room revenue use USD for the fixture. OFFER_EMBEDDING VECTOR(384) is added only in Lab 3."
    },
    "GUESTS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "GUEST_ID": "NUMBER PK",
        "FIRST_NAME": "VARCHAR2(80)",
        "LAST_NAME": "VARCHAR2(80)",
        "EMAIL": "VARCHAR2(200)",
        "LOYALTY_TIER": "VARCHAR2(30)",
        "LOCATION": "SDO_GEOMETRY",
        "PREFERENCES": "JSON"
      },
      "note": "LOCATION is a requested arrival/relocation point. Use synthetic example.com contacts and optional preferences, never real guest data."
    },
    "RESERVATIONS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "RESERVATION_ID": "NUMBER PK",
        "GUEST_ID": "NUMBER FK",
        "PROPERTY_ID": "NUMBER FK",
        "CHECK_IN": "DATE",
        "CHECK_OUT": "DATE",
        "RESERVATION_STATUS": "VARCHAR2(30)",
        "RESERVATION_TOTAL": "NUMBER(12,2)",
        "SERVICE_FEE": "NUMBER(12,2)",
        "DEMAND_SCORE": "NUMBER",
        "CREATED_AT": "TIMESTAMP DEFAULT SYSTIMESTAMP"
      },
      "note": "One room per reservation, checkout exclusive; statuses pending/confirmed/checked_in/checked_out/cancelled/no_show. Nullable demand score; default creation timestamp. ID columns GENERATED BY DEFAULT or explicit IDs so the lab can insert its reserved IDs."
    },
    "RESERVATION_NIGHTS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "NIGHT_LINE_ID": "NUMBER PK",
        "RESERVATION_ID": "NUMBER FK",
        "OFFER_ID": "NUMBER FK",
        "ROOM_NIGHTS": "NUMBER",
        "NIGHTLY_RATE": "NUMBER(12,2)",
        "LINE_TOTAL": "NUMBER(12,2) generated"
      },
      "note": "Aggregated nightly-charge line. LINE_TOTAL = ROOM_NIGHTS * NIGHTLY_RATE. Line offer must belong to the reservation property. Sum ROOM_NIGHTS equals CHECK_OUT-CHECK_IN for the one-room fixture. Distinct nightly rates may use separate lines."
    },
    "GUEST_POSTS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "POST_ID": "NUMBER PK",
        "GUEST_ID": "NUMBER FK nullable",
        "POST_TEXT": "VARCHAR2(4000)",
        "SENTIMENT": "NUMBER",
        "LIKES": "NUMBER",
        "SHARES": "NUMBER",
        "VIEWS": "NUMBER",
        "VIRALITY": "NUMBER",
        "SEVERITY_SCORE": "NUMBER",
        "AFFECTED_RESERVATIONS": "NUMBER",
        "SERVICE_CASES_OPENED": "NUMBER"
      },
      "note": "Synthetic guest service observations and social activity; post metrics support the same OML exercise as the reference."
    },
    "POST_OFFER_MENTIONS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "POST_ID": "NUMBER PK FK",
        "OFFER_ID": "NUMBER PK FK"
      },
      "note": "Composite PK avoids duplicate post/offer joins."
    },
    "OFFER_EMBEDDINGS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "OFFER_ID": "NUMBER PK FK",
        "EMBEDDING": "VECTOR(384)"
      },
      "note": "Preloaded with ADMIN.ALL_MINILM_L12_V2 before Lab 1. Lab 3 separately creates STAY_OFFERS.OFFER_EMBEDDING with the same model and text recipe."
    },
    "DEMAND_REGIONS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "REGION_ID": "NUMBER PK",
        "REGION_NAME": "VARCHAR2(120) UNIQUE",
        "DEMAND_INDEX": "NUMBER",
        "BOUNDARY": "SDO_GEOMETRY"
      },
      "note": ""
    },
    "BOOKING_ENTITIES": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "ENTITY_ID": "NUMBER PK",
        "ENTITY_KEY": "VARCHAR2(100) UNIQUE",
        "DISPLAY_NAME": "VARCHAR2(160)",
        "ENTITY_TYPE": "VARCHAR2(30)",
        "RISK_SCORE": "NUMBER",
        "RISK_LEVEL": "VARCHAR2(20)",
        "CHANNEL": "VARCHAR2(30)",
        "TOTAL_AMOUNT": "NUMBER(12,2)",
        "EVENT_COUNT": "NUMBER",
        "IS_CONFIRMED_ABUSE": "NUMBER(1)",
        "RESERVATION_ID": "NUMBER FK nullable",
        "PROPERTY_ID": "NUMBER FK nullable"
      },
      "note": "Types reservation/device/ip_address/phone/email/payment_token/property. Reservation and property vertices link to their business rows. TOTAL_AMOUNT is associated booking value, not money transferred among entities."
    },
    "BOOKING_RELATIONSHIPS": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "RELATIONSHIP_ID": "NUMBER PK",
        "FROM_ENTITY": "NUMBER FK",
        "TO_ENTITY": "NUMBER FK",
        "RELATIONSHIP_TYPE": "VARCHAR2(60)",
        "STRENGTH": "NUMBER",
        "EVENT_COUNT": "NUMBER",
        "TOTAL_AMOUNT": "NUMBER(12,2)"
      },
      "note": "Directed evidence links; use USES_DEVICE, USES_TOKEN, USES_PHONE, USES_IP, AT_PROPERTY, and IDENTIFIES_RESERVATION. Reverse evidence links must be explicit when directed multi-hop paths require them."
    },
    "BOOKING_CASES": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "CASE_ID": "NUMBER PK",
        "CASE_REF": "VARCHAR2(80) UNIQUE",
        "CASE_TYPE": "VARCHAR2(40)",
        "STATUS": "VARCHAR2(30)",
        "RISK_SCORE": "NUMBER",
        "LOSS_AMOUNT": "NUMBER(12,2)",
        "EVENT_COUNT": "NUMBER"
      },
      "note": ""
    },
    "BOOKING_CASE_ENTITIES": {
      "kind": "table",
      "created_by": "loader",
      "columns": {
        "CASE_ENTITY_ID": "NUMBER PK",
        "CASE_ID": "NUMBER FK",
        "ENTITY_ID": "NUMBER FK",
        "ROLE": "VARCHAR2(40)",
        "EVIDENCE_SCORE": "NUMBER"
      },
      "note": ""
    },
    "STAY_OFFERS_V": {
      "kind": "view",
      "created_by": "loader",
      "columns": {
        "OFFER_ID": "NUMBER",
        "OFFER_NAME": "VARCHAR2(160)",
        "PROPERTY_ID": "NUMBER",
        "OFFER_CATEGORY": "VARCHAR2(100)"
      },
      "note": "Projects STAY_OFFERS.CATEGORY as OFFER_CATEGORY; one row per offer."
    },
    "HOTEL_PROPERTIES_V": {
      "kind": "view",
      "created_by": "loader",
      "columns": {
        "PROPERTY_ID": "NUMBER",
        "PROPERTY_NAME": "VARCHAR2(120)",
        "CITY": "VARCHAR2(100)",
        "STATE_PROVINCE": "VARCHAR2(100)"
      },
      "note": "One row per HOTEL_PROPERTIES property."
    },
    "SERVICE_ALERTS_V": {
      "kind": "view",
      "created_by": "loader",
      "columns": {
        "ALERT_ID": "NUMBER",
        "SEVERITY_SCORE": "NUMBER",
        "AFFECTED_RESERVATIONS": "NUMBER",
        "SERVICE_CASES_OPENED": "NUMBER"
      },
      "note": "Projects GUEST_POSTS.POST_ID as ALERT_ID. Counts describe each alert; sum across alerts is not a unique reservation count."
    },
    "OML_STAY_DEMAND_TRAINING_V": {
      "kind": "view",
      "created_by": "loader",
      "columns": {
        "OFFER_ID": "NUMBER",
        "CATEGORY": "VARCHAR2(100)",
        "NIGHTLY_RATE": "NUMBER",
        "TOTAL_POSTS": "NUMBER",
        "AVG_SENTIMENT": "NUMBER",
        "TOTAL_LIKES": "NUMBER",
        "TOTAL_SHARES": "NUMBER",
        "TOTAL_VIEWS": "NUMBER",
        "AVG_VIRALITY": "NUMBER",
        "VIRAL_POSTS": "NUMBER",
        "RISING_POSTS": "NUMBER",
        "ROOM_NIGHTS_BOOKED": "NUMBER",
        "REVENUE": "NUMBER",
        "SURGE_LABEL": "VARCHAR2(10)"
      },
      "note": "One row per active offer. Preaggregate posts separately from reservation lines to prevent join fanout. Booked room revenue sums LINE_TOTAL for confirmed/checked_in/checked_out only. Seed both SURGE and STABLE labels. Record synthetic label rules, aggregation window, and thresholds in the Phase 2 loader; they are not validated forecasts."
    },
    "RESERVATIONS_DV": {
      "kind": "duality_view",
      "created_by": "loader",
      "columns": {
        "DATA": "JSON"
      },
      "note": "Initial loader view has the exact Lab 2 JSON shape but WITH UPDATE on root and child. Lab 2 enables WITH INSERT UPDATE. JSON keys: _id, guestId, propertyId, checkIn, checkOut, status, total, serviceFee, demandScore, createdAt, items[{nightLineId,offerId,roomNights,nightlyRate}]."
    },
    "THOMAS_APP_DATA": {
      "kind": "table",
      "created_by": "lab2",
      "columns": {
        "RESERVATION_ID": "NUMBER PK",
        "APP_DATA": "JSON"
      },
      "note": ""
    },
    "THOMAS_RESERVATION_DOCS": {
      "kind": "json_collection",
      "created_by": "lab2",
      "columns": {
        "DATA": "JSON"
      },
      "note": "Application-owned snapshot, WITH ETAG; does not synchronize automatically with base reservation tables."
    },
    "OTTO_STAY_DEMAND_SETTINGS": {
      "kind": "table",
      "created_by": "lab6",
      "columns": {
        "SETTING_NAME": "VARCHAR2(30)",
        "SETTING_VALUE": "VARCHAR2(4000)"
      },
      "note": ""
    },
    "OTTO_STAY_DEMAND_SCORING_DATA": {
      "kind": "table",
      "created_by": "lab6",
      "columns": {
        "OFFER_ID": "NUMBER",
        "CATEGORY": "VARCHAR2(100)",
        "NIGHTLY_RATE": "NUMBER",
        "TOTAL_POSTS": "NUMBER",
        "AVG_SENTIMENT": "NUMBER",
        "TOTAL_LIKES": "NUMBER",
        "TOTAL_SHARES": "NUMBER",
        "TOTAL_VIEWS": "NUMBER",
        "AVG_VIRALITY": "NUMBER",
        "VIRAL_POSTS": "NUMBER",
        "RISING_POSTS": "NUMBER",
        "ROOM_NIGHTS_BOOKED": "NUMBER",
        "REVENUE": "NUMBER"
      },
      "note": "Synthetic perturbation of training rows; no SURGE_LABEL and not an independent holdout."
    },
    "LOYALTY_MEMBERS": {
      "kind": "table",
      "created_by": "optional_loader",
      "columns": {
        "MEMBER_ID": "NUMBER PK",
        "GUEST_ID": "NUMBER FK",
        "NAME": "VARCHAR2(160)"
      },
      "note": "Optional PGX vertices; MEMBER_ID identifies a hotel loyalty member."
    },
    "LOYALTY_POINT_TRANSFERS": {
      "kind": "table",
      "created_by": "optional_loader",
      "columns": {
        "TRANSFER_ID": "NUMBER PK",
        "FROM_MEMBER_ID": "NUMBER FK",
        "TO_MEMBER_ID": "NUMBER FK",
        "POINTS": "NUMBER",
        "DESCRIPTION": "VARCHAR2(200)"
      },
      "note": "Directed transfer of hotel loyalty points. PGQL edge label TRANSFERS."
    }
  },
  "foreign_keys": [
    {
      "table": "STAY_OFFERS",
      "column": "PROPERTY_ID",
      "references": "HOTEL_PROPERTIES",
      "key": "PROPERTY_ID"
    },
    {
      "table": "RESERVATIONS",
      "column": "GUEST_ID",
      "references": "GUESTS",
      "key": "GUEST_ID"
    },
    {
      "table": "RESERVATIONS",
      "column": "PROPERTY_ID",
      "references": "HOTEL_PROPERTIES",
      "key": "PROPERTY_ID"
    },
    {
      "table": "RESERVATION_NIGHTS",
      "column": "RESERVATION_ID",
      "references": "RESERVATIONS",
      "key": "RESERVATION_ID"
    },
    {
      "table": "RESERVATION_NIGHTS",
      "column": "OFFER_ID",
      "references": "STAY_OFFERS",
      "key": "OFFER_ID"
    },
    {
      "table": "GUEST_POSTS",
      "column": "GUEST_ID",
      "references": "GUESTS",
      "key": "GUEST_ID"
    },
    {
      "table": "POST_OFFER_MENTIONS",
      "column": "POST_ID",
      "references": "GUEST_POSTS",
      "key": "POST_ID"
    },
    {
      "table": "POST_OFFER_MENTIONS",
      "column": "OFFER_ID",
      "references": "STAY_OFFERS",
      "key": "OFFER_ID"
    },
    {
      "table": "OFFER_EMBEDDINGS",
      "column": "OFFER_ID",
      "references": "STAY_OFFERS",
      "key": "OFFER_ID"
    },
    {
      "table": "BOOKING_ENTITIES",
      "column": "RESERVATION_ID",
      "references": "RESERVATIONS",
      "key": "RESERVATION_ID"
    },
    {
      "table": "BOOKING_ENTITIES",
      "column": "PROPERTY_ID",
      "references": "HOTEL_PROPERTIES",
      "key": "PROPERTY_ID"
    },
    {
      "table": "BOOKING_RELATIONSHIPS",
      "column": "FROM_ENTITY",
      "references": "BOOKING_ENTITIES",
      "key": "ENTITY_ID"
    },
    {
      "table": "BOOKING_RELATIONSHIPS",
      "column": "TO_ENTITY",
      "references": "BOOKING_ENTITIES",
      "key": "ENTITY_ID"
    },
    {
      "table": "BOOKING_CASE_ENTITIES",
      "column": "CASE_ID",
      "references": "BOOKING_CASES",
      "key": "CASE_ID"
    },
    {
      "table": "BOOKING_CASE_ENTITIES",
      "column": "ENTITY_ID",
      "references": "BOOKING_ENTITIES",
      "key": "ENTITY_ID"
    },
    {
      "table": "LOYALTY_MEMBERS",
      "column": "GUEST_ID",
      "references": "GUESTS",
      "key": "GUEST_ID"
    },
    {
      "table": "LOYALTY_POINT_TRANSFERS",
      "column": "FROM_MEMBER_ID",
      "references": "LOYALTY_MEMBERS",
      "key": "MEMBER_ID"
    },
    {
      "table": "LOYALTY_POINT_TRANSFERS",
      "column": "TO_MEMBER_ID",
      "references": "LOYALTY_MEMBERS",
      "key": "MEMBER_ID"
    }
  ],
  "lab_added_columns": {
    "STAY_OFFERS": {
      "OFFER_EMBEDDING": "VECTOR(384)"
    }
  },
  "graphs": {
    "BOOKING_ABUSE_NETWORK": {
      "language": "SQL/PGQ",
      "vertices": {
        "entity": "BOOKING_ENTITIES",
        "booking_case": "BOOKING_CASES"
      },
      "edges": {
        "related_to": "BOOKING_RELATIONSHIPS",
        "contains_entity": "BOOKING_CASE_ENTITIES"
      }
    },
    "LOYALTY_GRAPH": {
      "language": "PGQL/PGX",
      "vertices": {
        "member": "LOYALTY_MEMBERS"
      },
      "edges": {
        "TRANSFERS": "LOYALTY_POINT_TRANSFERS"
      },
      "optional": true
    }
  },
  "models": [
    "ADMIN.ALL_MINILM_L12_V2",
    "OTTO_STAY_DEMAND_SURGE_MODEL"
  ],
  "ai_profile": "GENAI",
  "agent_objects": [
    "NINA_HOSPITALITY_SQL_TOOL",
    "NINA_HOSPITALITY_AGENT",
    "NINA_HOSPITALITY_TASK",
    "NINA_HOSPITALITY_TEAM"
  ]
}
