        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "Degree and PageRank measure different graph properties, so the two lists can differ. Now inspect paths between fixture members 934 and 387. Review the intermediate members and the transfer evidence before drawing conclusions."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Check the shortest path between member 934 and member 387 */",
          "SELECT v,e,v2",
          "FROM MATCH SHORTEST (a)-[:TRANSFERS]->+(b) ON loyalty_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.member_id=934 AND b.member_id=387"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": "[{\"visualization\": {\"vertexLabelProperty\": \"MEMBER_ID\", \"version\": 9}}]",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
