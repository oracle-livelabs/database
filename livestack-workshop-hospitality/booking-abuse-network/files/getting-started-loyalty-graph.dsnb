        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%python-pgx",
          "graph = session.get_graph(\"LOYALTY_GRAPH\")",
          "analyst.pagerank(graph);"
        ],
        "selectedVisualization": "raw",
        "visualizationConfig": null,
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
