        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Check if there are any circular points-transfer chains of length 4 from member 934 */",
          "SELECT v,e,v2",
          "FROM MATCH ALL (a)-[:TRANSFERS]->{4}(b) ON loyalty_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.member_id=934 AND id(a) = id(b)",
          "LIMIT 100"
        ],
