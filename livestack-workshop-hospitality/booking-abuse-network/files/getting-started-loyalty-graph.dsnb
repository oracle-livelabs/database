        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "Circular points transfers can indicate repeated movement among linked members. They can also have a legitimate explanation. Compare connectivity with PageRank, which measures graph importance, not a loyalty-points balance.",
          "The Python API uses the built-in session and analyst objects and the loaded LOYALTY_GRAPH."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
