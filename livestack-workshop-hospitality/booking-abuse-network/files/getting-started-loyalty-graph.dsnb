        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "List PageRank values in descending order. A high rank means that a member has incoming links from members that themselves carry rank. This is a structural graph measure; it does not prove abuse or measure points volume."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* List members in descending order of pagerank values*/",
          "SELECT a.member_id, a.pagerank AS pageRank",
          "FROM MATCH (a) ON loyalty_graph",
          "ORDER BY PageRank DESC",
          "LIMIT 10"
        ],
        "selectedVisualization": "table",
        "visualizationConfig": "[{\"visualization\": {\"version\": 9}}]",
        "hideCode": false,
