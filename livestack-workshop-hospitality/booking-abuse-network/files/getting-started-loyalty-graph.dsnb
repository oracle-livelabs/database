        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Find the top 3 shortest paths between member 934 and member 387 */",
          "SELECT v,e,v2",
          "FROM MATCH TOP 3 SHORTEST (a)-[:TRANSFERS]->+ (b) ON loyalty_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.member_id=934 AND b.member_id=387"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": "[{\"visualization\": {\"vertexLabelProperty\": \"MEMBER_ID\", \"version\": 9}}]",
        "hideCode": false,
