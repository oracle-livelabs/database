        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "Circular material transfers can indicate repeated movement among linked centers. They can also have a legitimate explanation. Compare connectivity with PageRank, which measures graph importance, not an inventory balance.",
          "The Python API uses the built-in session and analyst objects and the loaded MATERIAL_FLOW_GRAPH."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%python-pgx",
          "graph = session.get_graph(\"MATERIAL_FLOW_GRAPH\")",
          "analyst.pagerank(graph);"
        ],
        "selectedVisualization": "raw",
        "visualizationConfig": null,
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
