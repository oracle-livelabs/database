        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "List PageRank values in descending order. A high rank means that a center has incoming links from centers that themselves carry rank. This is a structural graph measure; it does not prove a quality defect or measure material volume."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* List centers in descending order of pagerank values*/",
          "SELECT a.center_id, a.pagerank AS pageRank",
          "FROM MATCH (a) ON material_flow_graph",
          "ORDER BY PageRank DESC",
          "LIMIT 10"
        ],
        "selectedVisualization": "table",
        "visualizationConfig": "[{\"visualization\": {\"version\": 9}}]",
        "hideCode": false,
