        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Find the top 5 shortest paths between center 934 and center 387 */",
          "SELECT v,e,v2",
          "FROM MATCH TOP 5 SHORTEST (a)-[:TRANSFERS]->+ (b) ON material_flow_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.center_id=934 AND b.center_id=387"
