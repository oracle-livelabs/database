        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "Degree and PageRank measure different graph properties, so the two lists can differ. Now inspect paths between sample centers 934 and 387. Review the intermediate centers and the transfer records before drawing conclusions."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Check the shortest path between center 934 and center 387 */",
          "SELECT v,e,v2",
          "FROM MATCH SHORTEST (a)-[:TRANSFERS]->+(b) ON material_flow_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.center_id=934 AND b.center_id=387"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": "[{\"visualization\": {\"vertexLabelProperty\": \"CENTER_ID\", \"version\": 9}}]",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "The next queries return the **3 shortest** and **5 shortest** paths, ordered by hop count. "
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
