          "%pgql-pgx",
          "/* List 10 centers with the most number of material transfers (that is, incoming + outgoing edges) */",
          "SELECT a.center_id, (in_degree(a) + out_degree(a)) AS num_transfers",
          "FROM MATCH (a) ON material_flow_graph",
          "ORDER BY num_transfers DESC",
          "LIMIT 10"
        ],
