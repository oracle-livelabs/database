{"env":{"defaultTimeZone":"UTC"},"items":[{"statementId":1,"statementType":"query","statementPos":{"startLine":1,"endLine":18},"statementText":"SELECT hp.plant_name,\n           hp.city,\n           hp.state_province,\n           ROUND(\n             SDO_GEOM.SDO_DISTANCE(\n               hp.location,\n               dr.boundary,\n               0.005,\n               'unit=KM'\n             ), 2\n           ) AS boundary_distance_km,\n           dr.region_name,\n           dr.demand_index\n    FROM plants hp\n    CROSS JOIN demand_regions dr\n    WHERE dr.region_name = 'New York Electronics Region'\n    ORDER BY boundary_distance_km\n    FETCH FIRST 10 ROWS ONLY","resultSet":{"metadata":[{"columnName":"PLANT_NAME","jsonColumnName":"plant_name","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":120,"scale":0,"isNullable":0},{"columnName":"CITY","jsonColumnName":"city","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":100,"scale":0,"isNullable":0},{"columnName":"STATE_PROVINCE","jsonColumnName":"state_province","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":100,"scale":0,"isNullable":0},{"columnName":"BOUNDARY_DISTANCE_KM","jsonColumnName":"boundary_distance_km","columnTypeName":"NUMBER","columnClassName":"java.math.BigDecimal","precision":0,"scale":-127,"isNullable":1},{"columnName":"REGION_NAME","jsonColumnName":"region_name","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":120,"scale":0,"isNullable":0},{"columnName":"DEMAND_INDEX","jsonColumnName":"demand_index","columnTypeName":"NUMBER","columnClassName":"java.math.BigDecimal","precision":0,"scale":-127,"isNullable":0}],"items":[{"plant_name":"SEER Edison Plant","city":"Edison","state_province":"New Jersey","boundary_distance_km":0,"region_name":"New York Electronics Region","demand_index":91},{"plant_name":"SEER Newark Plant","city":"Newark","state_province":"New Jersey","boundary_distance_km":0,"region