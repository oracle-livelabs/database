[{"name": "Material Flow Prerequisite", "description": "Execute the optional PGQL graph definition supplied in the loader.", "tags": null, "version": "7", "layout": "zeppelin", "type": "Default", "snapshot": false, "isEditable": true, "isRunnable": true, "template": "dsrgmn3y", "templateConfig": "{\"visualization\":{\"filters\":[{\"_id\":1583324064459,\"type\":\"styling\",\"enabled\":true,\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"hiddenConnection\",\"operator\":\"*\",\"value\":\"\"}]},\"component\":\"edge\",\"target\":\"edge\",\"properties\":{\"colors\":[\"rgba(0, 0, 0, 0.1)\"],\"style\":[\"dashed\"],\"legendTitle\":[\"Hidden Connection\"]}},{\"_id\":1590499315755,\"type\":\"aggregation\",\"enabled\":true,\"conditions\":{\"operator\":\"and\",\"conditions\":[]},\"component\":\"vertex\",\"target\":\"vertex\",\"properties\":{},\"aggregation\":[{\"source\":\"\",\"type\":\"average\"}]}],\"version\":4}}", "paragraphs": [{"row": 0, "col": 0, "sizeX": 0, "width": 12, "title": null, "hasTitle": false, "message": ["%pgql-rdbms", "CREATE PROPERTY GRAPH material_flow_graph\n     VERTEX TABLES (\n       work_centers KEY (center_id)\n         LABEL center PROPERTIES (center_id, plant_id, name)\n     )\n     EDGE TABLES (\n       material_transfers KEY (transfer_id)\n         SOURCE KEY (from_center_id) REFERENCES work_centers (center_id)\n         DESTINATION KEY (to_center_id) REFERENCES work_centers (center_id)\n         LABEL TRANSFERS\n         PROPERTIES (transfer_id, from_center_id, to_center_id, quantity_units, description)\n     ) OPTIONS (PG_PGQL);"], "selectedVisualization": "table", "visualizationConfig": null, "hideCode": false, "hideResult": false, "hideGutter": true, "hideVizConfig": false, "hideInIFrame": false, "enabled": true, "forms": "[]", "relations": [], "dynamicFormParams": "{}", "result": null}]}]