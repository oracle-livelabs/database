{"env":{"defaultTimeZone":"UTC"},"items":[{"statementId":1,"statementType":"query","statementPos":{"startLine":1,"endLine":31},"statementText":"WITH matched_components AS (\n        SELECT so.component_id,\n               so.component_name,\n               ROUND(1 - VECTOR_DISTANCE(\n                 so.component_embedding,\n                 VECTOR_EMBEDDING(\n                   ADMIN.ALL_MINILM_L12_V2\n                   USING 'power control module with stable MOSFET switching and low leakage current' AS DATA\n                 ),\n                 COSINE), 4) AS similarity\n        FROM components so\n        ORDER BY similarity DESC\n        FETCH FIRST 5 ROWS ONLY\n    )\n    SELECT matched_component.component_name,\n           matched_component.similarity,\n           g.site_name,\n           g.first_name || ' ' || g.last_name AS contact_name,\n           g.email,\n           r.production_order_id,\n           r.order_status,\n           r.created_at,\n           rn.quantity,\n           rn.line_total\n    FROM matched_components matched_component\n    JOIN production_order_lines rn ON rn.component_id = matched_component.component_id\n    JOIN production_orders r ON r.production_order_id = rn.production_order_id\n    JOIN customer_sites g ON g.customer_site_id = r.customer_site_id\n    WHERE r.order_status IN ('planned', 'released', 'in_production')\n    ORDER BY matched_component.similarity DESC,\n             r.created_at DESC","resultSet":{"metadata":[{"columnName":"COMPONENT_NAME","jsonColumnName":"component_name","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":160,"scale":0,"isNullable":0},{"columnName":"SIMILARITY","jsonColumnName":"similarity","columnTypeName":"NUMBER","columnClassName":"java.math.BigDecimal","precision":0,"scale":-127,"isNullable":1},{"columnName":"SITE_NAME","jsonColumnName":"site_name","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":160,"scale":0,"isNullable":0},{"columnName":"CONTACT_NAME","jsonColumnName":"contact_name","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":161,"scale":0,"isNullable":1},{"columnName":"EMAIL","jsonColumnName":"email","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":200,"scale":0,"isNullable":0},{"columnName":"PRODUCTION_ORDER_ID","jsonColumnName":"production_order_id","columnTypeName":"NUMBER","columnClassName":"java.math.BigDecimal","precision":0,"scale":-127,"isNullable":0},{"columnName":"ORDER_STATUS","jsonColumnName":"order_status","columnTypeName":"VARCHAR2","columnClassName":"java.lang.String","precision":30,"scale":0,"isNullable":0},{"columnName":"CREATED_AT","jsonColumnName":"created_at","columnTypeName":"TIMESTAMP","columnClassName":"oracle.sql.TIMESTAMP","precision":0,"scale":6,"isNullable":0},{"columnName":"QUANTITY","jsonColumnName":"quantity","columnTypeName":"NUMBER","columnClassName":"java.math.BigDecimal","precision":0,"scale":-127,"isNullable":0},{"columnName":"LINE_TOTAL","jsonColumnName":"line_total","columnTypeName":"NUMBER","columnClassName":"java.math.BigDecimal","precision":0,"scale":-127,"isNullable":0}],"items":[{"component_name":"Power control module P02 Rev A","similarity":0.7602,"site_name":"Electronics Customer Site 0114","contact_name":"Contact0114 Example","email":"production0114@example.com","production_order_id":11135,"order_status":"planned","created_at":"2026-08-20T10:00:00Z","quantity":37,"line_total":4625},{"component_name":"Power control module P02 Rev A","similarity":0.7602,"site_name":"Electronics Customer Site 1010","contact_name":"Contact1010 Example","email":"production1010@example.com","production_order_id":13055,"order_status":"planned","created_at":"2026-08-20T10:00:00Z","quantity":33,"line_total":4125},{"component_name":"Power control module P02 Rev A","similarity":0.7602,"site_name":"Electronics Customer Site 0130","contact_name":"Contact0130 Example","email":"production0130@example.com","production_order_id"