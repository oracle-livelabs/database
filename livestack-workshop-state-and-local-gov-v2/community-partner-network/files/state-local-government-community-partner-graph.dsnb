              "message" : "{\"schema\":\"LLUSER\",\"name\":\"default\",\"resultSetId\":\"78fba877-73e3-4081-80cf-8719d1f354f0\",\"graph\":{\"vertices\":[{\"id\":\"BRANDS{\\\"BRAND_ID\\\":1}\",\"properties\":{\"BRAND_CATEGORY\":\"Health and Human Services\",\"BRAND_ID\":1,\"BRAND_NAME\":\"Benefits Eligibility\",\"SOCIAL_TIER\":\"statewide\"},\"labels\":[\"BRAND\"]},{\"id\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":1}\",\"properties\":{\"CITY\":\"Denver\",\"ENGAGEMENT_RATE\":0.081,\"NICHE\":\"Benefits Eligibility\",\"IS_VERIFIED\":1,\"HANDLE\":\"@co-benefits\",\"PLATFORM\":\"community\",\"INFLUENCE_SCORE\":94,\"REGION\":\"Colorado\",\"INFLUENCER_ID\":1,\"FOLLOWER_COUNT\":85000,\"DISPLAY_NAME\":\"Colorado Benefits Network\"},\"labels\":[\"INFLUENCER\"]},{\"id\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":2}\",\"properties\":{\"CITY\":\"Grand Junction\",\"ENGAGEMENT_RATE\":0.074,\"NICHE\":\"Family Support\",\"IS_VERIFIED\":1,\"HANDLE\":\"@western-slope-family\",\"PLATFORM\":\"partner\",\"INFLUENCE_SCORE\":89,\"REGION\":\"Colorado\",\"INFLUENCER_ID\":2,\"FOLLOWER_COUNT\":42000,\"DISPLAY_NAME\":\"Western Slope Family Resource Alliance\"},\"labels\":[\"INFLUENCER\"]},{\"id\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":3}\",\"properties\":{\"CITY\":\"Denver\",\"ENGAGEMENT_RATE\":0.068,\"NICHE\":\"Human Services\",\"IS_VERIFIED\":1,\"HANDLE\":\"@county-human-services\",\"PLATFORM\":\"agency\",\"INFLUENCE_SCORE\":87,\"REGION\":\"Colorado\",\"INFLUENCER_ID\":3,\"FOLLOWER_COUNT\":61000,\"DISPLAY_NAME\":\"County Human Services Collaborative\"},\"labels\":[\"INFLUENCER\"]},{\"id\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":4}\",\"properties\":{\"CITY\":\"Fort Collins\",\"ENGAGEMENT_RATE\":0.063,\"NICHE\":\"Housing\",\"IS_VERIFIED\":1,\"HANDLE\":\"@front-range-housing\",\"PLATFORM\":\"partner\",\"INFLUENCE_SCORE\":82,\"REGION\":\"Colorado\",\"INFLUENCER_ID\":4,\"FOLLOWER_COUNT\":36000,\"DISPLAY_NAME\":\"Front Range Housing Partnership\"},\"labels\":[\"INFLUENCER\"]}],\"edges\":[{\"id\":\"BRAND_INFLUENCER_LINKS{\\\"LINK_ID\\\":1}\",\"properties\":{\"AVG_ENGAGEMENT\":0.081,\"POST_COUNT\":18,\"RELATIONSHIP_TYPE\":\"ambassador\"},\"labels\":[\"PROMOTES\"],\"source\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":1}\",\"target\":\"BRANDS{\\\"BRAND_ID\\\":1}\"},{\"id\":\"BRAND_INFLUENCER_LINKS{\\\"LINK_ID\\\":2}\",\"properties\":{\"AVG_ENGAGEMENT\":0.074,\"POST_COUNT\":14,\"RELATIONSHIP_TYPE\":\"organic\"},\"labels\":[\"PROMOTES\"],\"source\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":2}\",\"target\":\"BRANDS{\\\"BRAND_ID\\\":1}\"},{\"id\":\"INFLUENCER_CONNECTIONS{\\\"CONNECTION_ID\\\":1}\",\"properties\":{\"CONNECTION_TYPE\":\"collaborates\",\"INTERACTION_COUNT\":42,\"STRENGTH\":0.92},\"labels\":[\"CONNECTS_TO\"],\"source\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":1}\",\"target\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":2}\"},{\"id\":\"INFLUENCER_CONNECTIONS{\\\"CONNECTION_ID\\\":2}\",\"properties\":{\"CONNECTION_TYPE\":\"follows\",\"INTERACTION_COUNT\":35,\"STRENGTH\":0.88},\"labels\":[\"CONNECTS_TO\"],\"source\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":1}\",\"target\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":3}\"},{\"id\":\"INFLUENCER_CONNECTIONS{\\\"CONNECTION_ID\\\":3}\",\"properties\":{\"CONNECTION_TYPE\":\"collaborates\",\"INTERACTION_COUNT\":28,\"STRENGTH\":0.81},\"labels\":[\"CONNECTS_TO\"],\"source\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":2}\",\"target\":\"INFLUENCERS{\\\"INFLUENCER_ID\\\":4}\"}],\"numResults\":3,\"graphOwner\":\"LLUSER\",\"graphName\":\"INFLUENCER_NETWORK\",\"isLastResultSet\":true,\"vertexIdColumnNames\":[\"PROGRAM_ID\",\"SOURCE_PARTNER_ID\",\"CONNECTED_PARTNER_ID\"],\"edgeIdColumnNames\":[\"PROGRAM_LINK_ID\",\"HANDOFF_ID\"]},\"table\":\"PROGRAM_ID\\tSOURCE_PARTNER_ID\\tPROGRAM_LINK_ID\\tHANDOFF_ID\\tCONNECTED_PARTNER_ID\\n{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"BRANDS\\\",\\\"KEY_VALUE\\\":{\\\"BRAND_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCERS\\\",\\\"KEY_VALUE\\\":{\\\"INFLUENCER_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"BRAND_INFLUENCER_LINKS\\\",\\\"KEY_VALUE\\\":{\\\"LINK_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCER_CONNECTIONS\\\",\\\"KEY_VALUE\\\":{\\\"CONNECTION_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCERS\\\",\\\"KEY_VALUE\\\":{\\\"INFLUENCER_ID\\\":2}}\\n{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"BRANDS\\\",\\\"KEY_VALUE\\\":{\\\"BRAND_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCERS\\\",\\\"KEY_VALUE\\\":{\\\"INFLUENCER_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"BRAND_INFLUENCER_LINKS\\\",\\\"KEY_VALUE\\\":{\\\"LINK_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCER_CONNECTIONS\\\",\\\"KEY_VALUE\\\":{\\\"CONNECTION_ID\\\":2}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCERS\\\",\\\"KEY_VALUE\\\":{\\\"INFLUENCER_ID\\\":3}}\\n{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"BRANDS\\\",\\\"KEY_VALUE\\\":{\\\"BRAND_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"INFLUENCERS\\\",\\\"KEY_VALUE\\\":{\\\"INFLUENCER_ID\\\":2}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"BRAND_INFLUENCER_LINKS\\\",\\\"KEY_VALUE\\\":{\\\"LINK_ID\\\":2}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"INFLUENCER_NETWORK\