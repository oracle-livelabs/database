        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "**Order 50 Product Requirements**",
          "",
          "Start with Order 50, assigned to Fall River Northeast Safety Hub. Inspect its two order lines and product quantities. This is a supply-order example, not a confirmed disruption, recall, allocation or clinical shipment."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "SELECT order_id, item_id, product_id, product_name, units_required",
          "FROM GRAPH_TABLE (ls_supply_network",
          "  MATCH (o IS supply_order)-[c IS contains_line]->(l IS order_line)",
          "        -[r IS requires_product]->(p IS product)",
          "  WHERE o.order_id = 50",
          "  COLUMNS (o.order_id AS order_id, l.item_id AS item_id,",
          "           p.product_id AS product_id, p.product_name AS product_name,",
          "           l.quantity AS units_required)",
          ")",
          "ORDER BY item_id;"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
