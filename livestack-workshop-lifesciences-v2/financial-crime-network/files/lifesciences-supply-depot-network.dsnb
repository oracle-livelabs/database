        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "**Graph Visualization of the Order Requirements**",
          "",
          "Run the next query. It follows depot → order → order line → product. The two paths share the same order and assigned depot. The picture contains six distinct vertices and five edges; the common first edge may appear in more than one returned path. Select a vertex or edge to inspect its properties."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "SELECT *",
          "FROM GRAPH_TABLE (ls_supply_network",
          "  MATCH (d IS depot)-[a IS assigned_order]->(o IS supply_order)",
          "        -[c IS contains_line]->(l IS order_line)",
          "        -[r IS requires_product]->(p IS product)",
          "  WHERE d.center_id = 10 AND o.order_id = 50",
          "  ONE ROW PER STEP (v1, e1, v2)",
          "  COLUMNS (VERTEX_ID(v1) AS v1_id,",
          "           EDGE_ID(e1) AS e1_id,",
          "           VERTEX_ID(v2) AS v2_id)",
          ");"
        ],
        "selectedVisualization" : "visualization",
        "visualizationConfig" : "[{\"visualization\":{\"height\":520,\"version\":11,\"ruleBasedStyles\":[{\"_id\":\"60b6f5cc\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"DEPOT\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ENTITY\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#8FBFD0\"},\"legendTitle\":\"DEPOT, SUPPLY_ENTITY\",\"isDefaultRule\":true},{\"_id\":\"32bb9f1d\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"ORDER_LINE\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ENTITY\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#F0CC71\"},\"legendTitle\":\"ORDER_LINE, SUPPLY_ENTITY\",\"isDefaultRule\":true},{\"_id\":\"-3ee8248e\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ENTITY\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ORDER\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#F7A0A0\"},\"legendTitle\":\"SUPPLY_ENTITY, SUPPLY_ORDER\",\"isDefaultRule\":true},{\"_id\":\"-1384479\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PRODUCT\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ENTITY\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#A3C194\"},\"legendTitle\":\"PRODUCT, SUPPLY_ENTITY\",\"isDefaultRule\":true},{\"_id\":\"5edb7ed7\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"ASSIGNED_ORDER\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_LINK\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"ASSIGNED_ORDER, SUPPLY_LINK\",\"isDefaultRule\":true},{\"_id\":\"2f165ee\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"CONTAINS_LINE\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_LINK\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"CONTAINS_LINE, SUPPLY_LINK\",\"isDefaultRule\":true},{\"_id\":\"-68f03be8\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"REQUIRES_PRODUCT\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_LINK\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"REQUIRES_PRODUCT, SUPPLY_LINK\",\"isDefaultRule\":true},{\"_id\":\"ls-supply-depot\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"DEPOT\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"DEPOT\"}]},\"style\":{\"color\":\"#d79d51\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#d79d51\"}},{\"_id\":\"ls-supply-supply_order\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"SUPPLY_ORDER\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ORDER\"}]},\"style\":{\"color\":\"#8da4cb\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#8da4cb\"}},{\"_id\":\"ls-supply-order_line\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"ORDER_LINE\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"ORDER_LINE\"}]},\"style\":{\"color\":\"#a9bba4\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#a9bba4\"}},{\"_id\":\"ls-supply-product\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"PRODUCT\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PRODUCT\"}]},\"style\":{\"color\":\"#77b6be\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#77b6be\"}}],\"displaySizeOnLoad\":11,\"lastColumns\":[\"V1_ID\",\"E1_ID\",\"V2_ID\"]}}]",
