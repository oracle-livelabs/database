      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "**Alternative Depot Coverage**",
          "",
          "First review the same inventory-qualified candidates as Task 4. Required quantities are summed per product before stock is checked. Every product must be covered at a candidate depot, which must be active and different from the original depot."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "WITH required_products AS (",
          "  SELECT product_id, SUM(quantity) AS units_required",
          "  FROM order_items",
          "  WHERE order_id = 50",
          "  GROUP BY product_id",
          "), graph_stock AS (",
          "  SELECT product_id, center_id, center_name, is_active, units_available",
          "  FROM GRAPH_TABLE (ls_supply_network",
          "    MATCH (p IS product)-[s IS stocked_at]->(d IS depot)",
          "    COLUMNS (p.product_id AS product_id, d.center_id AS center_id,",
          "             d.center_name AS center_name, d.is_active AS is_active,",
          "             s.quantity_on_hand - s.quantity_reserved AS units_available)",
          "  )",
          ")",
          "SELECT s.center_id, s.center_name,",
          "       COUNT(*) AS products_covered,",
          "       SUM(r.units_required) AS order_units_required,",
          "       MIN(s.units_available - r.units_required) AS minimum_product_surplus",
          "FROM required_products r",
          "JOIN graph_stock s ON s.product_id = r.product_id",
          "WHERE s.is_active = 1",
          "  AND s.center_id <> (SELECT fulfillment_center_id FROM orders WHERE order_id = 50)",
          "  AND s.units_available >= r.units_required",
          "GROUP BY s.center_id, s.center_name",
          "HAVING COUNT(*) = (SELECT COUNT(*) FROM required_products)",
          "ORDER BY s.center_id;"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "**Shared Stocking Depots**",
          "",
          "Now draw the two required products and their four shared candidate depots: 12, 13, 15 and 24. The final visualization has six vertices and eight inventory edges. It shows the same qualification using ordinary SQL for an independent comparison. Recorded stock is on-hand minus reserved, not a temperature, release-status or delivery guarantee. This is a shortlist for Order 50 alone; no inventory is reserved or moved."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "WITH required_products AS (",
          "  SELECT product_id, SUM(quantity) AS units_required",
          "  FROM order_items WHERE order_id = 50",
          "  GROUP BY product_id",
          "), qualified_depots AS (",
          "  SELECT d.center_id",
          "  FROM required_products r",
          "  JOIN inventory s ON s.product_id = r.product_id",
          "  JOIN fulfillment_centers d ON d.center_id = s.center_id",
          "  WHERE d.is_active = 1",
          "    AND d.center_id <> (SELECT fulfillment_center_id FROM orders WHERE order_id = 50)",
          "    AND s.quantity_on_hand - s.quantity_reserved >= r.units_required",
          "  GROUP BY d.center_id",
          "  HAVING COUNT(*) = (SELECT COUNT(*) FROM required_products)",
          ")",
          "SELECT v1_id, e1_id, v2_id",
          "FROM GRAPH_TABLE (ls_supply_network",
          "  MATCH (p IS product)-[s IS stocked_at]->(d IS depot)",
          "  COLUMNS (p.product_id AS product_key, d.center_id AS depot_key,",
          "           VERTEX_ID(p) AS v1_id, EDGE_ID(s) AS e1_id,",
          "           VERTEX_ID(d) AS v2_id)",
          ") g",
          "WHERE g.product_key IN (SELECT product_id FROM required_products)",
          "  AND g.depot_key IN (SELECT center_id FROM qualified_depots);"
        ],
        "selectedVisualization" : "visualization",
        "visualizationConfig" : "[{\"visualization\":{\"height\":520,\"version\":11,\"ruleBasedStyles\":[{\"_id\":\"60b6f5cc\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"DEPOT\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ENTITY\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#8FBFD0\"},\"legendTitle\":\"DEPOT, SUPPLY_ENTITY\",\"isDefaultRule\":true},{\"_id\":\"-1384479\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PRODUCT\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ENTITY\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#F0CC71\"},\"legendTitle\":\"PRODUCT, SUPPLY_ENTITY\",\"isDefaultRule\":true},{\"_id\":\"-26f99809\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"STOCKED_AT\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_LINK\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"STOCKED_AT, SUPPLY_LINK\",\"isDefaultRule\":true},{\"_id\":\"ls-supply-depot\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"DEPOT\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"DEPOT\"}]},\"style\":{\"color\":\"#d79d51\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#d79d51\"}},{\"_id\":\"ls-supply-supply_order\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"SUPPLY_ORDER\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"SUPPLY_ORDER\"}]},\"style\":{\"color\":\"#8da4cb\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#8da4cb\"}},{\"_id\":\"ls-supply-order_line\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"ORDER_LINE\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"ORDER_LINE\"}]},\"style\":{\"color\":\"#a9bba4\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#a9bba4\"}},{\"_id\":\"ls-supply-product\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"component\":\"vertex\",\"target\":\"vertex\",\"type\":\"styling\",\"isDefaultRule\":true,\"legendTitle\":\"PRODUCT\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PRODUCT\"}]},\"style\":{\"color\":\"#77b6be\",\"size\":20,\"label\":{\"text\":\"${properties['DISPLAY_NAME']}\",\"color\":\"#1f2937\",\"font\":{\"size\":13}}},\"properties\":{\"color\":\"#77b6be\"}}],\"displaySizeOnLoad\":100,\"lastColumns\":[\"V1_ID\",\"E1_ID\",\"V2_ID\"]}}]",
