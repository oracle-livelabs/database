        "message" : [
          "%md",
          "",
          "This visualization narrows the investigation to the device DEV-fp-91a7 and shows every entity directly connected to it. The red device at the center links multiple account vertices, including ACCT-8841, ACCT-5077, and ACCT-1190, revealing that they share the same access device. The additional IP-address connection provides supporting context: it may indicate another shared attribute associated with the same device and should be investigated alongside the linked accounts."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
