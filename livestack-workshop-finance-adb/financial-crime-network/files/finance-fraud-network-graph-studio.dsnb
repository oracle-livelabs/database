          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "<p>This visualization narrows the investigation to the device DEV-fp-91a7 and shows every entity directly connected to it. The red device at the center links multiple account vertices, including ACCT-8841, ACCT-5077, and ACCT-1190, revealing that they share the same access device. The additional IP-address connection provides supporting context: it may indicate another shared attribute associated with the same device and should be investigated alongside the linked accounts.</p>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  fraud_network",
          "  MATCH (account IS entity) -[e IS related_to]- (device IS entity)",
          "  WHERE device.entity_key = 'DEV-fp-91a7'",
          "  COLUMNS (",
          "    vertex_id(account) AS account_id,",
          "    edge_id(e)         AS related_to_id,",
          "    vertex_id(device)  AS device_id",
          "  )",
          ");"
        ],
