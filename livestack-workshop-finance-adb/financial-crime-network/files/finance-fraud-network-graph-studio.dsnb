        "message": [
          "%md",
          "# Investigate the Seer Bank Fraud Network",
          "",
          "This notebook uses the existing `FRAUD_NETWORK` property graph from the Finance LiveStack dataset. Run the paragraphs from top to bottom.",
          "",
          "- Paragraphs 1 and 3 return ranked evidence tables.",
          "- Paragraphs 2 and 4 render the same relationship patterns as interactive graph visualizations.",
          "- Use the triangle **Run** button on each SQL paragraph. Generated layouts can vary while the underlying entities and relationships remain the same."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
