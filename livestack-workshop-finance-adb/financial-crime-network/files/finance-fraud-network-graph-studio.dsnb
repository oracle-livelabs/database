"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_ENTITIES\\\",\\\"KEY_VALUE\\\":{\\\"ENTITY_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_ENTITIES\\\",\\\"KEY_VALUE\\\":{\\\"ENTITY_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_RELATIONSHIPS\\\",\\\"KEY_VALUE\\\":{\\\"RELATIONSHIP_ID\\\":4}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_ENTITIES\\\",\\\"KEY_VALUE\\\":{\\\"ENTITY_ID\\\":14}}\\n{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_ENTITIES\\\",\\\"KEY_VALUE\\\":{\\\"ENTITY_ID\\\":1}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_ENTITIES\\\",\\\"KEY_VALUE\\\":{\\\"ENTITY_ID\\\":14}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_RELATIONSHIPS\\\",\\\"KEY_VALUE\\\":{\\\"RELATIONSHIP_ID\\\":35}}\\t{\\\"GRAPH_OWNER\\\":\\\"LLUSER\\\",\\\"GRAPH_NAME\\\":\\\"FRAUD_NETWORK\\\",\\\"ELEM_TABLE\\\":\\\"FRAUD_ENTITIES\\\",\\\"KEY_VALUE\\\":{\\\"ENTITY_ID\\\":11}}\"}",
