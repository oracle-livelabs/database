      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%sql",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  service_restoration_network",
          "  MATCH (src IS utility_entity)-[e IS restoration_link]->{1,2}(dst IS utility_entity)",
          "  WHERE src.entity_key = 'GLK-2208'",
          "  ONE ROW PER STEP (v1, e1, v2)",
          "  COLUMNS (",
          "    vertex_id(src) AS seed_id,",
          "    vertex_id(v1) AS v1_id,",
          "    edge_id(e1) AS e1_id,",
          "    vertex_id(v2) AS v2_id",
          "  )",
          ");"
        ],
