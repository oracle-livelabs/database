        "message": [
          "%md",
          "This view centers on PIPE-17A and shows adjacent entities in either direction. Inspect the actual edge types and keys. Colors and layout are presentation choices, not a risk or causality conclusion."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
