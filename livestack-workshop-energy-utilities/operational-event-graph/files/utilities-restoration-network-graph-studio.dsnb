        "message": [
          "%md",
          "**Utilities Restoration Network**",
          "Investigate GLK-2208 and the pipeline, crew, work order, and inspection records linked to it. Run the paragraphs below to build the table and graph views."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
