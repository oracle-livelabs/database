      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%sql",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  service_restoration_network",
          "  MATCH (event IS utility_entity) -[e IS restoration_link]- (asset IS utility_entity)",
          "  WHERE asset.entity_key = 'PIPE-17A'",
          "  COLUMNS (",
          "    vertex_id(event) AS event_id,",
          "    edge_id(e)         AS related_to_id,",
          "    vertex_id(asset)  AS asset_id",
          "  )",
          ");"
        ],
        "selectedVisualization": "visualization",
