        "hasTitle": false,
        "message": [
          "%md",
          "Circular airtime transfers can indicate repeated movement among linked accounts. They can also have a legitimate explanation. Compare connectivity with PageRank, which measures graph importance, not a prepaid voice-minute balance.",
          "The Python API uses the built-in session and analyst objects and the loaded AIRTIME_GRAPH."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
