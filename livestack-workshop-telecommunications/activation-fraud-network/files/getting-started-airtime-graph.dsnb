        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "List PageRank values in descending order. A high rank means that an account has incoming links from accounts that themselves carry rank. This is a structural graph measure; it does not prove abuse or measure airtime volume."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
