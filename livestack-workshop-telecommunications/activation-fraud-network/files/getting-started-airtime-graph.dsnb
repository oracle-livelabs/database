        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* List accounts in descending order of pagerank values*/",
          "SELECT a.account_id, a.pagerank AS pageRank",
          "FROM MATCH (a) ON airtime_graph",
          "ORDER BY PageRank DESC",
          "LIMIT 10"
        ],
        "selectedVisualization": "table",
