        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Find the top 3 shortest paths between account 934 and account 387 */",
          "SELECT v,e,v2",
          "FROM MATCH TOP 3 SHORTEST (a)-[:TRANSFERS]->+ (b) ON airtime_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.account_id=934 AND b.account_id=387"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": "[{\"visualization\": {\"vertexLabelProperty\": \"ACCOUNT_ID\", \"version\": 9}}]",
        "hideCode": false,
