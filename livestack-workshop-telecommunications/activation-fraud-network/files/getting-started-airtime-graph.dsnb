        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "Degree and PageRank measure different graph properties, so the two lists can differ. Now inspect paths between sample accounts 934 and 387. Review the intermediate accounts and the transfer records before drawing conclusions."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "result": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%pgql-pgx",
          "/* Check the shortest path between account 934 and account 387 */",
          "SELECT v,e,v2",
          "FROM MATCH SHORTEST (a)-[:TRANSFERS]->+(b) ON airtime_graph ONE ROW PER STEP (v,e,v2)",
          "WHERE a.account_id=934 AND b.account_id=387"
        ],
        "selectedVisualization": "visualization",
        "visualizationConfig": "[{\"visualization\": {\"vertexLabelProperty\": \"ACCOUNT_ID\", \"version\": 9}}]",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
