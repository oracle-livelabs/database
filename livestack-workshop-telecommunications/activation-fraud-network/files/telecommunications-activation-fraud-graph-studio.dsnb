        "hasTitle": false,
        "message": [
          "%md",
          "",
          "This visualization narrows the investigation to the device DEV-fp-91a7 and shows every entity directly connected to it. The supplied style highlights the device in red. The fixture requires links to service order vertices ORD-8841, ORD-5077, and ORD-1190; verify those shared-device links in your results. If present, an IP-address connection provides supporting context: it may indicate another shared attribute associated with the same device and should be investigated alongside the linked service_orders."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
