      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%sql",
          "",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  activation_fraud_network",
          "  MATCH (order_node IS entity) -[e IS related_to]- (device IS entity)",
          "  WHERE device.entity_key = 'DEV-fp-91a7'",
          "  COLUMNS (",
          "    vertex_id(order_node) AS order_id,",
          "    edge_id(e)         AS related_to_id,",
          "    vertex_id(device)  AS device_id",
          "  )",
          ");"
        ],
        "selectedVisualization": "visualization",
