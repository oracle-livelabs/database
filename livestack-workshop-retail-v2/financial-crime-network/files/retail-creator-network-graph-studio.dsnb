        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "message": [
          "%pgql-pgx",
          "SELECT src, e, dst",
          "FROM MATCH (src:INFLUENCER)-[e:CONNECTS_TO]->(dst:INFLUENCER)",
          "ON INFLUENCER_NETWORK",
          "WHERE src.INFLUENCER_ID = 1",
          "LIMIT 50"
        ],
