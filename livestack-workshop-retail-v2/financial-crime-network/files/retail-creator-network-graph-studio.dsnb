        "dynamicFormParams": "{}",
        "message": [
          "%sql",
          "SELECT *",
          "FROM GRAPH_TABLE (LLUSER.INFLUENCER_NETWORK",
          "  MATCH (creator IS influencer)-[promotion IS promotes]->(brand IS brand)",
          "  WHERE brand.brand_id = 1",
          "  COLUMNS (",
          "    vertex_id(creator) AS creator_id,",
          "    edge_id(promotion) AS promotion_id,",
          "    vertex_id(brand) AS brand_id",
          "  )",
          ");"
        ],
        "result": null,
