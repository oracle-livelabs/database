        "message": [
          "%md",
          "The next view centers on brand 1 and its recorded promotions. Follow the incoming PROMOTES edges from creator nodes. Inspect BRAND_NAME and HANDLE, then compare RELATIONSHIP_TYPE across the links. Shared promotion does not establish a shared audience or sales attribution."
        ],
        "result": null,
        "visualizationConfig": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Shared brand: brand 1",
        "hasTitle": true,
        "selectedVisualization": "visualization",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
