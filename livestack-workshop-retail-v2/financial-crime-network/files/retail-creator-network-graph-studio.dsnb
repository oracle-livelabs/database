        "dynamicFormParams": "{}",
        "message": [
          "%md",
          "# Retail Creator Network",
          "",
          "Bob Green is the graph specialist at Seer Sporting Goods. Compare the SQL evidence with creator and brand relationships in this notebook. Run the main SQL paragraphs as LLUSER. The notebook contains no precomputed query results."
        ],
        "result": null,
        "visualizationConfig": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Direct creator connections",
        "hasTitle": true,
        "selectedVisualization": "table",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "message": [
          "%sql",
          "SELECT from_creator AS \"From Creator\",",
          "       to_creator AS \"To Creator\",",
          "       connection_type AS \"Link\",",
          "       strength AS \"Strength\"",
          "FROM GRAPH_TABLE ( LLUSER.INFLUENCER_NETWORK",
          "  MATCH (src IS influencer) -[e IS connects_to]-> (dst IS influencer)",
          "  COLUMNS (",
          "    src.handle AS from_creator,",
          "    dst.handle AS to_creator,",
          "    e.connection_type AS connection_type,",
          "    e.strength AS strength",
          "  )",
          ")",
          "ORDER BY strength DESC, from_creator, to_creator",
          "FETCH FIRST 5 ROWS ONLY;"
        ],
        "result": null,
        "visualizationConfig": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Brand relationships over two creator hops",
        "hasTitle": true,
        "selectedVisualization": "table",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "message": [
          "%sql",
          "SELECT DISTINCT brand_name AS \"Brand\",",
          "       promoter AS \"Promoter\",",
          "       reached AS \"Reached\",",
          "       relationship_type AS \"Relationship\"",
          "FROM GRAPH_TABLE ( LLUSER.INFLUENCER_NETWORK",
          "  MATCH (b IS brand) <-[p IS promotes]- (i IS influencer) -[c IS connects_to]->{1,2} (j IS influencer)",
          "  COLUMNS (",
          "    b.brand_name AS brand_name,",
          "    i.handle AS promoter,",
          "    j.handle AS reached,",
          "    p.relationship_type AS relationship_type",
          "  )",
          ")",
          "ORDER BY brand_name, promoter, reached, relationship_type",
          "FETCH FIRST 5 ROWS ONLY;"
        ],
        "result": null,
        "visualizationConfig": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Read the visual map",
        "hasTitle": true,
        "selectedVisualization": "html",
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "message": [
          "%md",
          "The next query follows one directed creator connection from creator 1 (@trail_maya_1). Inspect HANDLE on each vertex and CONNECTION_TYPE and STRENGTH on each edge. A connection is recorded network evidence, not a count of people who saw a campaign."
        ],
        "result": null,
        "visualizationConfig": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Creator 1: connection map",
        "hasTitle": true,
        "selectedVisualization": "visualization",
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "relations": [],
        "dynamicFormParams": "{}",
        "message": [
          "%sql",
          "SELECT *",
          "FROM GRAPH_TABLE (LLUSER.INFLUENCER_NETWORK",
          "  MATCH (src IS influencer)-[e IS connects_to]->(dst IS influencer)",
          "  WHERE src.influencer_id = 1",
          "  COLUMNS (",
          "    vertex_id(src) AS source_id,",
          "    edge_id(e) AS connection_id,",
          "    vertex_id(dst) AS destination_id",
          "  )",
          ");"
        ],
        "result": null,
        "visualizationConfig": "[{\"visualization\": {\"height\": 480, \"ruleBasedStyles\": [{\"_id\": \"retail-influencer\", \"stylingEnabled\": true, \"visibilityEnabled\": true, \"target\": \"vertex\", \"component\": \"vertex\", \"type\": \"styling\", \"isDefaultRule\": true, \"conditions\": {\"operator\": \"and\", \"conditions\": [{\"property\": \"labels\", \"operator\": \"CONTAINS\", \"value\": \"INFLUENCER\"}]}, \"style\": {\"color\": \"#487a9a\", \"label\": {\"text\": \"${properties['HANDLE']}\", \"font\": {\"size\": 12}}}, \"legendTitle\": \"INFLUENCER\"}, {\"_id\": \"retail-brand\", \"stylingEnabled\": true, \"visibilityEnabled\": true, \"target\": \"vertex\", \"component\": \"vertex\", \"type\": \"styling\", \"isDefaultRule\": true, \"conditions\": {\"operator\": \"and\", \"conditions\": [{\"property\": \"labels\", \"operator\": \"CONTAINS\", \"value\": \"BRAND\"}]}, \"style\": {\"color\": \"#b15b3b\", \"label\": {\"text\": \"${properties['BRAND_NAME']}\", \"font\": {\"size\": 12}}}, \"legendTitle\": \"BRAND\"}], \"version\": 11}}]"
      },
